{
  "permissions": {
    "allow": [
      "Bash(git rm:*)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Read(//Users/nishchaybeharam/.claude/skills/**)",
      "Bash(npx -y skills add coreyhaines31/marketingskills)",
      "Bash(npx -y skills add --help)",
      "Bash(npx -y skills --help)",
      "Bash(npx -y skills add coreyhaines31/marketingskills -y --agent claude-code)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|skill",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PROJECT_DIR || '.', '.claude', 'hooks', 'check-gstack.cjs'))\""
          }
        ]
      }
    ]
  }
}
